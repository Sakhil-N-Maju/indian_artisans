# Environment Variables Configuration

# API Keys for AI Services
# =========================

# Google Gemini AI API Key
# Get your API key from: https://makersuite.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Fallback)
# Get your API key from: https://platform.openai.com/api-keys
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Speech-to-Text API Keys
# =======================

# Google Cloud Speech-to-Text API Key
NEXT_PUBLIC_GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here

# Azure Cognitive Services Speech API Key
NEXT_PUBLIC_AZURE_SPEECH_API_KEY=your_azure_speech_api_key_here
NEXT_PUBLIC_AZURE_SPEECH_REGION=your_azure_region_here

# Translation API Keys
# ====================

# Google Cloud Translation API Key
NEXT_PUBLIC_GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Database Configuration
# ======================

# MongoDB Connection String (for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/artisans?retryWrites=true&w=majority

# PostgreSQL Connection String (alternative)
DATABASE_URL=postgresql://username:password@localhost:5432/artisans

# Storage Configuration
# ====================

# AWS S3 for image/video storage
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_S3_BUCKET=your_s3_bucket_name
AWS_REGION=us-east-1

# Cloudinary for media optimization
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway
# ===============

# Razorpay (Indian payment gateway)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Stripe (International payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Authentication
# ==============

# NextAuth Secret
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Service
# =============

# SendGrid for transactional emails
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@artisansofindia.com

# Resend for emails
RESEND_API_KEY=your_resend_api_key

# WhatsApp Business API
# ====================

# Meta WhatsApp Business API credentials
# Get from: https://developers.facebook.com/apps
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token_here

# Analytics
# =========

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Application Settings
# ====================

# Environment
NODE_ENV=development

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
# =============

# Enable AI features
NEXT_PUBLIC_ENABLE_AI_FEATURES=true

# Enable voice recording
NEXT_PUBLIC_ENABLE_VOICE_FEATURES=true

# Enable payment processing
NEXT_PUBLIC_ENABLE_PAYMENTS=false

# Enable analytics tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=false
